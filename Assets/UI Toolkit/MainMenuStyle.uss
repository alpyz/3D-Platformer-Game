.header {
    font-size: 376px;
    -unity-font-definition: resource("FlatSkin/Font/Roboto-Regular");
    color: rgb(255, 255, 255);
}

.button {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    background-color: rgba(56, 56, 56, 0);
    background-image: url("project://database/Assets/UI%20Sprites/Main%20Menu/button.png?fileID=21300000&guid=68c7ed4d95549f345b3dfafff1f0576a&type=3#button");
    width: 220px;
    height: 50px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    align-self: center;
    align-items: stretch;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-cubic;
}

.button:hover {
    scale: 1.1 1.1 1.1;
    -unity-background-image-tint-color: rgb(255, 0, 0);
}
